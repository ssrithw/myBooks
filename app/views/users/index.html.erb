<% content_for :title, "Readers" %>

<div class="page-head">
  <h1>Readers</h1>
</div>

<% if @users.any? %>
  <ul class="reader-list">
    <% @users.each do |user| %>
      <li>
        <%= link_to user.username, user_path(user), class: "reader-name" %>
        <span class="muted">
          <%= pluralize(user.shared_count.to_i, "shared book") %>
          · joined <%= user.created_at.strftime("%B %Y") %>
        </span>
      </li>
    <% end %>
  </ul>
<% else %>
  <p class="empty">No one has signed up yet :(</p>
<% end %>
