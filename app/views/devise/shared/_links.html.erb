<div class="auth-links">
  <% if controller_name != "sessions" %>
    <p class="hint">Already have an account? <%= link_to "Log in", new_session_path(resource_name) %></p>
  <% end %>
  <% if devise_mapping.registerable? && controller_name != "registrations" %>
    <p class="hint">New here? <%= link_to "Create an account!", new_registration_path(resource_name) %></p>
  <% end %>
</div>
