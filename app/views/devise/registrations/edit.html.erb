<% content_for :title, "Account settings" %>

<div class="form-narrow">
  <h1>Account settings</h1>
  <p class="muted">Signed in as <strong><%= resource.username_was %></strong>.</p>

  <%= form_with(model: resource, as: resource_name, url: registration_path(resource_name), method: :put, class: "stack") do |form| %>
    <%= render "shared/errors", record: resource %>

    <div class="field">
      <%= form.label :username %>
      <%= form.text_field :username, required: true, autocomplete: "username",
            minlength: 3, maxlength: 20, pattern: "[A-Za-z0-9_]{3,20}", autocapitalize: "none", spellcheck: false %>
      <p class="hint">3 to 20 letters, numbers or underscores. Changing this changes your profile address.</p>
    </div>

    <div class="field">
      <%= form.label :email %>
      <%= form.email_field :email, value: resource.email_was, disabled: true, aria: { describedby: "email-hint" } %>
      <p id="email-hint" class="hint">Your email can't be changed.</p>
    </div>

    <div class="field">
      <%= form.label :password, "New password" %>
      <%= form.password_field :password, minlength: @minimum_password_length, autocomplete: "new-password" %>
      <p class="hint">Leave blank to keep your current password.</p>
    </div>
    <div class="field">
      <%= form.label :password_confirmation, "Confirm new password" %>
      <%= form.password_field :password_confirmation, autocomplete: "new-password" %>
    </div>

    <div class="field">
      <%= form.label :current_password %>
      <%= form.password_field :current_password, required: true, autocomplete: "current-password" %>
      <p class="hint">Needed to confirm any change.</p>
    </div>

    <div class="actions">
      <%= form.submit "Save changes", class: "button" %>
      <%= link_to "Cancel", user_path(resource), class: "button button-ghost" %>
    </div>
  <% end %>
</div>
