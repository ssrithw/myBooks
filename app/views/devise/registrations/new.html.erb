<% content_for :title, "Sign up" %>

<div class="form-narrow">
  <h1>Create your shelf</h1>

  <%= form_with(model: resource, as: resource_name, url: registration_path(resource_name), class: "stack") do |form| %>
    <%= render "shared/errors", record: resource %>

    <div class="field">
      <%= form.label :username %>
      <%= form.text_field :username, required: true, autofocus: true, autocomplete: "username",
            minlength: 3, maxlength: 20, pattern: "[A-Za-z0-9_]{3,20}", autocapitalize: "none", spellcheck: false %>
      <p class="hint">3 to 20 letters, numbers or underscores.</p>
    </div>
    <div class="field">
      <%= form.label :email %>
      <%= form.email_field :email, required: true, autocomplete: "email" %>
    </div>
    <div class="field">
      <%= form.label :password %>
      <%= form.password_field :password, required: true, minlength: @minimum_password_length, autocomplete: "new-password" %>
      <% if @minimum_password_length %>
        <p class="hint">At least <%= @minimum_password_length %> characters.</p>
      <% end %>
    </div>
    <div class="field">
      <%= form.label :password_confirmation, "Confirm password" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password" %>
    </div>

    <div class="actions">
      <%= form.submit "Create account", class: "button" %>
    </div>
  <% end %>

  <%= render "devise/shared/links" %>
</div>
